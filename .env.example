# ARGUS-PRIME environment variables
# Copy to .env and fill in real values — never commit .env

# Server
HOST=0.0.0.0
PORT=8080

# NIM inference endpoint
NIM_ENDPOINT=https://nim.internal

# MCP client endpoints
ROBINHOOD_MCP_URL=
COINBASE_MCP_URL=
TELEGRAM_MCP_URL=
SHOPIFY_MCP_URL=
WEB_LLM_MCP_URL=
TURBO_QUANTUM_MCP_URL=
CBI_INSIGHTS_MCP_URL=
X402_MCP_URL=
WHISPER_MCP_URL=
OPENJARVIS_MCP_URL=

# Mobile
ARGUS_PRIME_URL=http://localhost:8080

# ICP Caffeine Agent
ICP_CAFFEINE_ENDPOINT=

# External secrets (populated by VaultGemma)
VAULTGEMMA_KEY=
GOOGLE_DATA_COMMONS_API_KEY=
